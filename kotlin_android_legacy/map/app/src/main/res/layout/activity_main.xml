<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        />

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        tools:ignore="RelativeOverlap"
        android:layout_alignParentRight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layoutDirection="rtl">



    <ScrollView
        android:id="@+id/main_btns_container"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="@drawable/wallpaper"
        >

        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="70dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="جيولوجية المملكة"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:textFontWeight="600"
                android:layout_marginTop="30dp"

                />

            <Button
                android:id="@+id/brief"
                android:layout_width="match_parent"
                android:text="مقدمة"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <Button
                android:id="@+id/arabian_shield"
                android:layout_width="match_parent"
                android:text="الدرع العربي"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <Button
                android:id="@+id/arabian_platform"
                android:layout_width="match_parent"
                android:text="الرصيف العربي"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <Button
                android:id="@+id/harat"
                android:layout_width="match_parent"
                android:text="الحرات البركانية"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <Button
                android:id="@+id/swahel"
                android:layout_width="match_parent"
                android:text="السهول الساحلية"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

        </LinearLayout>
    </ScrollView>

   <LinearLayout
            android:id="@+id/icons_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical"
            tools:ignore="RelativeOverlap"
            >

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:srcCompat="@drawable/home"
                android:backgroundTint="#C17F4D2C"
                android:contentDescription="TODO" />


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/reset_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:srcCompat="@drawable/zoom"
                android:backgroundTint="#C17F4D2C"
                android:contentDescription="reset the zoom of the map"
                />

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
