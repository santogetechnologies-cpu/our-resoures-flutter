<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        />

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        tools:ignore="RelativeOverlap"
        android:layout_alignParentRight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layoutDirection="rtl">


    <ScrollView
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="@drawable/wallpaper"
        >

        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="70dp"

            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="حقول البترول والغاز"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:textFontWeight="600"
                android:layout_marginTop="30dp"

                />

            <Button
                android:id="@+id/brief"
                android:layout_width="match_parent"
                android:text="مقدمة"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <Button
                android:id="@+id/oil"
                android:layout_width="match_parent"
                android:text="حقول البترول"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <LinearLayout
                android:id="@+id/oil_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Place your buttons or other expandable content here -->
                <Button
                    android:id="@+id/gawar"
                    android:text="حقل الغوار"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>


                <Button
                    android:id="@+id/korais"
                    android:text="حقل خريص"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/lgbah"
                    android:text="حقل اللغفة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/jub"
                    android:text="حقل الجوب"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/shatfah"
                    android:text="حقل الشطفة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/shaibah"
                    android:text="حقل الشيبة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/ramlah"
                    android:text="حقل الرملة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/hota"
                    android:text="حقل الحوطة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/buqaiq"
                    android:text="حقل بقيق"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/sofiniah"
                    android:text="حقل السفانية"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/munifiah"
                    android:text="حقل منيفة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>
                <Button
                    android:id="@+id/bury"
                    android:text="حقل البري"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

            </LinearLayout>


            <Button
                android:id="@+id/gas"
                android:layout_width="match_parent"
                android:text="حقول الغاز"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <LinearLayout
                android:id="@+id/gas_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Place your buttons or other expandable content here -->
                <Button
                    android:id="@+id/medin"
                    android:text="حقل مدين"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/shamaa"
                    android:text="حقل شمعة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/hilwah"
                    android:text="حقل الحلوة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/northKedn"
                    android:text="حقل الكدن الشمالي"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/southKedn"
                    android:text="حقل الكدن الجنوبي"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/heran"
                    android:text="حقل حيران"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/sherfa"
                    android:text="حقل الشرفة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/mehakek"
                    android:text="حقل المحاكيك"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/shodon"
                    android:text="حقل شدون"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

                <Button
                    android:id="@+id/otad"
                    android:text="حقل أوتاد"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>


                <Button
                    android:id="@+id/mezalej"
                    android:text="حقل مزاليج"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>


                <Button
                    android:id="@+id/osakera"
                    android:text="حقل عسيكرة"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

        <LinearLayout
            android:id="@+id/icons_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical"
            tools:ignore="RelativeOverlap">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:srcCompat="@drawable/home"
                android:backgroundTint="#C17F4D2C"
                android:contentDescription="TODO" />


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/reset_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:srcCompat="@drawable/zoom"
                android:backgroundTint="#C17F4D2C"
                android:contentDescription="reset the zoom of the map"
                />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
