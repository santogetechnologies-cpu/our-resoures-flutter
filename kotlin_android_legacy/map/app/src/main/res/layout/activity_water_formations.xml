<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"

        />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:background="@drawable/progress_bar_background" />

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        tools:ignore="RelativeOverlap"
        android:layout_alignParentRight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layoutDirection="rtl">


    <ScrollView
        android:id="@+id/sideBar"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:background="@drawable/wallpaper"
>



        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="70dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="مصادر المياه"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:textFontWeight="600"
                android:layout_marginTop="30dp" />

            <Button
                android:id="@+id/brief"
                android:text="مقدمة "
                android:textSize="24sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <Button
                android:id="@+id/Valleys"
                android:text="الأودية الرئيسية"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

        <LinearLayout
            android:id="@+id/valleys_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        </LinearLayout>

            <Button
                android:id="@+id/Dams"
                android:text="سدود الشرب"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <LinearLayout
                android:id="@+id/dams_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                >

            </LinearLayout>



            <Button
                android:id="@+id/mainFormations"
                android:text="التكوينات الرئيسية"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <LinearLayout
                android:id="@+id/mainFormations_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <Button
                android:id="@+id/saq"
                android:text="تكوين الساق"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />

            <Button
                android:id="@+id/tabuk"
                android:text="تكوين تبوك"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />

            <Button
                android:id="@+id/wajid"
                android:text="تكوين الوجيد"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />

                <Button
                    android:id="@+id/minjur"
                    android:text="تكوين المنجور"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"
                    />

            <Button
                android:id="@+id/biyadh"
                android:text="تكوين البياض"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />

            <Button
                android:id="@+id/wasii"
                android:text="تكوين الوسيع"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />


            <Button
                android:id="@+id/radmaa"
                android:text="تكوين أم الرضمة"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />

                <Button
                    android:id="@+id/dammam"
                    android:text="تكوين الدمام"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sub_btn_menu"
                    android:layout_margin="5dp"
                    android:textSize="20sp"
                    />

            <Button
                android:id="@+id/neojen"
                android:text="تكوين النيوجين"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />


        </LinearLayout>


            <Button
                android:id="@+id/subFormations"
                android:text="التكوينات الفرعية"
                android:textSize="25sp"
                android:gravity="center"
                android:background="@drawable/main_menu_btn"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginEnd="21dp"
                android:layout_marginStart="21dp"
                android:layout_marginTop="16dp"
                />

            <LinearLayout
            android:id="@+id/subFormations_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
                android:visibility="gone">

            <Button
                android:id="@+id/joof"
                android:text="تكوين الجوف"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
            />

            <Button
                android:id="@+id/khuf"
                android:text="تكوين الخف"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />


            <Button
                android:id="@+id/jilh"
                android:text="تكوين الجله"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />


            <Button
                android:id="@+id/darmaa"
                android:text="تكوين ضرماء"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />

            <Button
                android:id="@+id/skaka"
                android:text="تكوين سكاكا"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />

            <Button
                android:id="@+id/aruma"
                android:text="تكوين العرمه"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sub_btn_menu"
                android:layout_margin="5dp"
                android:textSize="20sp"
                />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

        <LinearLayout
            android:id="@+id/icons_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical"
            tools:ignore="RelativeOverlap">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:srcCompat="@drawable/home"
                android:backgroundTint="#C17F4D2C"
                android:contentDescription="TODO" />


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/reset_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:srcCompat="@drawable/zoom"
                android:backgroundTint="#C17F4D2C"
                android:contentDescription="reset the zoom of the map"
                />

        </LinearLayout>


    </LinearLayout>

</RelativeLayout>
