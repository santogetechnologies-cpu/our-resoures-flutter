<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY"
    android:adjustViewBounds="true"
    android:layoutDirection="rtl"
    >

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wallpaper5"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/logo"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/category_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >

        <!-- ImageView for the logo -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/saudi_vision"
            android:scaleType="fitCenter"
            android:contentDescription="Logo"
            android:layout_marginLeft="30dp"
            android:layout_gravity="left"

            />


        <!-- TextView for the text -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/notokufi_bold"
            android:gravity="center"
            android:text="ثراوتنا من أرضنا"
            android:textColor="@color/black"
            app:autoSizeMaxTextSize="40sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeTextType="uniform" />

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/d_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo"
            android:layout_marginLeft="30dp"
            android:layout_gravity="left"

            />

    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/logo"
        android:gravity="center"
        >

        <!-- Button 1 -->
        <Button
            android:id="@+id/button1"
            android:layout_width="300dp"
            android:text="نبذة تعريفية"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeMaxTextSize="40sp"
            android:gravity="center"
            android:background="@drawable/category_btn"
            android:fontFamily="@font/notokufi_regular"
            android:layout_height="100dp"
            android:layout_centerHorizontal="true"
            />



        <GridLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_below="@id/button1"
            android:padding="16dp"
            android:columnCount="2"
            android:rowCount="3"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginHorizontal="110dp"

            >
            <!-- Button 1 -->
            <Button
                android:id="@+id/button2"
                android:text="جيولوجية المملكة"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/category_btn"
                android:fontFamily="@font/notokufi_regular"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="5dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="38sp"
                />

            <!-- Button 1 -->
            <Button
                android:id="@+id/materials"
                android:text="الصخور والمعادن الإقتصادية"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/category_btn"
                android:fontFamily="@font/notokufi_regular"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="5dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="38sp"
                />

            <!-- Button 1 -->
            <Button
                android:id="@+id/waterFormarion"
                android:text="مصادر المياه"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/category_btn"
                android:fontFamily="@font/notokufi_regular"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="5dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="38sp"
                />

            <!-- Button 1 -->
            <Button
                android:id="@+id/oil"
                android:text="البترول والغاز"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/category_btn"
                android:fontFamily="@font/notokufi_regular"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="5dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="38sp"
                />




            <Button
                android:id="@+id/button7"
                android:text="السياحة والآثار"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/category_btn"
                android:fontFamily="@font/notokufi_regular"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="5dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="38sp"
                />

            <Button
                android:id="@+id/earthquakes"
                android:text="قاعدة البيانات الزلزالية"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/category_btn"
                android:fontFamily="@font/notokufi_regular"
                android:layout_margin="10dp"
                android:gravity="center"
                android:padding="5dp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="38sp"


                />
        </GridLayout>

        <!-- Resource button -->

        <Button
            android:id="@+id/button8"
            android:layout_width="602dp"
            android:layout_height="176dp"
            android:layout_below="@+id/buttons"
            android:layout_marginTop="139dp"
            android:background="@drawable/category_btn"
            android:fontFamily="@font/notokufi_regular"
            android:text="المصادر"
            app:autoSizeMaxTextSize="48sp"
            app:autoSizeMinTextSize="12sp"

            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/textViewDialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"/>
    </RelativeLayout>

</RelativeLayout>
